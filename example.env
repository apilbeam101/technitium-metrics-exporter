# Copy this file to .env and fill in real values. See docs/DESIGN.md §6 for
# the full configuration reference, including the per-target override naming
# rule for TECHNITIUM_API_TOKEN__<NAME> and TECHNITIUM_CA_BUNDLE_PATH__<NAME>.

# --- Targets --------------------------------------------------------------

TECHNITIUM_TARGETS=dns-a=https://dns-a.example.com:53443,dns-b=https://dns-b.example.com:53443
TECHNITIUM_API_TOKEN=

# Per-target overrides, named <NAME> upper-cased with "-" replaced by "_":
# TECHNITIUM_API_TOKEN__DNS_A=
# TECHNITIUM_CA_BUNDLE_PATH=
# TECHNITIUM_CA_BUNDLE_PATH__DNS_A=
# TECHNITIUM_TLS_INSECURE_SKIP_VERIFY=false
# TECHNITIUM_TLS_INSECURE_SKIP_VERIFY__DNS_A=false

# --- Behaviour -------------------------------------------------------------

METRICS_PORT=10153
METRICS_BIND_ADDRESS=0.0.0.0
POLL_INTERVAL_SECONDS=30
CLUSTER_POLL_INTERVAL_SECONDS=60
# Hard floor 60 — this endpoint triggers reverse-DNS lookups on the server
STATS_POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15
ENABLE_CLUSTER_COLLECTOR=false
ENABLE_STATS_COLLECTOR=false
ENABLE_STATS_QUERY_TYPES=false
ZONES_INCLUDE_INTERNAL=false
ENABLE_DEFAULT_METRICS=true
LOG_LEVEL=info
LOG_FORMAT=json

# --- Metrics listener TLS (optional) ---------------------------------------

# METRICS_TLS_CERT_PATH=
# METRICS_TLS_KEY_PATH=
# METRICS_TLS_CLIENT_CA_PATH=
# METRICS_TLS_MIN_VERSION=TLSv1.2
