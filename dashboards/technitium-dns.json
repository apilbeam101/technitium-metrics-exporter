{
  "title": "Technitium DNS",
  "uid": "technitium-dns",
  "description": "Technitium DNS Server health, zone health, and cluster state, from technitium-metrics-exporter.",
  "tags": [
    "technitium",
    "dns"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Exporter health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape reachable",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "up{job=\"technitium\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Node reachable",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Collector success",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_collector_success",
          "legendFormat": "{{ collector }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "0 means either a poll attempt failed, or (if held at 0 indefinitely) the API token is missing the permission this collector needs and it has never run."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache age (seconds)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_exporter_cache_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rendered series",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_exporter_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Per-node overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Query rate",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(technitium_queries_total[5m])",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cached vs. blocked rate",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(technitium_cached_total[5m])",
          "legendFormat": "{{ instance }} cached",
          "refId": "A"
        },
        {
          "expr": "rate(technitium_blocked_total[5m])",
          "legendFormat": "{{ instance }} blocked",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_uptime_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Clients seen",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_clients_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Zone health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "SOA serial divergence (max - min by zone)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (zone) (technitium_zone_soa_serial{job=\"technitium\"}) - min by (zone) (technitium_zone_soa_serial{job=\"technitium\"})",
          "legendFormat": "{{ zone }}",
          "refId": "A"
        }
      ],
      "description": "Nonzero means at least one polled node is serving a different SOA serial for this zone. Assumes the scrape job is named \"technitium\" (this project's own install guides use job_name: technitium) — a differently-named job renders no data here rather than an error. Internal system zones will show spurious divergence here if ZONES_INCLUDE_INTERNAL is enabled."
    },
    {
      "id": 14,
      "type": "state-timeline",
      "title": "DNSSEC status",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_zone_dnssec_status == 1",
          "legendFormat": "{{ zone }}: {{ status }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Disabled zones",
      "gridPos": {
        "h": 7,
        "w": 3,
        "x": 18,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(technitium_zone_disabled == 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Zones by type",
      "gridPos": {
        "h": 7,
        "w": 3,
        "x": 21,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_zones_by_type",
          "legendFormat": "{{ type }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Transfer health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": []
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Time to SOA expiry",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_zone_expiry_timestamp_seconds - time()",
          "legendFormat": "{{ zone }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Zones sync-failed",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(technitium_zone_sync_failed == 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Zones notify-failed",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(technitium_zone_notify_failed == 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Zones expired",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(technitium_zone_expired == 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Zone visibility (visible vs. reported)",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_zones_visible{job=\"technitium\"}",
          "legendFormat": "visible",
          "refId": "A"
        },
        {
          "expr": "technitium_zones_reported{job=\"technitium\"}",
          "legendFormat": "reported",
          "refId": "B"
        }
      ],
      "description": "reported requires the opt-in stats collector (ENABLE_STATS_COLLECTOR=true); absent otherwise. Both queries assume the scrape job is named \"technitium\"; a differently-named job renders no data here rather than an error."
    },
    {
      "id": 23,
      "type": "row",
      "title": "Protocol split",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": []
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Queries by protocol (window)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_stats_window_queries",
          "legendFormat": "{{ protocol }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Queries by response type (window)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_stats_window_queries_by_response",
          "legendFormat": "{{ response_type }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Queries by query type (window)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_stats_window_queries_by_type",
          "legendFormat": "{{ query_type }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Window length (seconds)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_stats_window_seconds",
          "refId": "A"
        }
      ],
      "description": "Every panel in this row is a sliding-window gauge covering this many seconds, not a rate — it steps down on every window slide rather than accumulating (D§5.4-5.5)."
    },
    {
      "id": 28,
      "type": "row",
      "title": "Cluster state",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": []
    },
    {
      "id": 29,
      "type": "state-timeline",
      "title": "Peer connection state",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_cluster_node_state == 1",
          "legendFormat": "{{ node_name }}: {{ state }}",
          "refId": "A"
        }
      ],
      "description": "Requires the opt-in cluster collector (ENABLE_CLUSTER_COLLECTOR=true); absent otherwise."
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Cluster peers",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_cluster_nodes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Cluster initialized",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_cluster_initialized",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Config last synced",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "technitium_cluster_config_last_synced_timestamp_seconds",
          "refId": "A"
        }
      ]
    }
  ]
}
