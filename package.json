{
  "name": "technitium-metrics-exporter",
  "version": "0.1.0",
  "description": "Prometheus exporter for Technitium DNS Server",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "technitium-metrics-exporter": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:unit": "node --experimental-strip-types --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test \"test/integration/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "check:native-addons": "node --experimental-strip-types scripts/check-no-native-addons.ts",
    "check:pack-allowlist": "node --experimental-strip-types scripts/check-pack-allowlist.ts",
    "check:license-compound": "node --experimental-strip-types scripts/check-license-compound.ts",
    "check:fixtures": "node --experimental-strip-types scripts/sanitize-fixtures.ts --check test/fixtures",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run check:native-addons && npm run check:pack-allowlist && npm run check:license-compound && npm run check:fixtures && npm run check:audit",
    "check:alerts": "node --experimental-strip-types scripts/check-alerts.ts",
    "check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "check:dco": "node --experimental-strip-types scripts/check-dco.ts",
    "fetch:promtool": "node --experimental-strip-types scripts/fetch-promtool.ts",
    "fetch:gitleaks": "node --experimental-strip-types scripts/fetch-gitleaks.ts",
    "changelog:extract": "node --experimental-strip-types scripts/extract-changelog-section.ts",
    "generate:metrics-doc": "node --experimental-strip-types scripts/generate-metrics-doc.ts",
    "generate:dashboard": "node --experimental-strip-types scripts/generate-dashboard.ts"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
